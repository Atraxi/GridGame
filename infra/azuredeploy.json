{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.47.16.16243",
      "templateHash": "1625782158885604067"
    }
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region for all resources. Defaults to the resource group location."
      }
    },
    "appName": {
      "type": "string",
      "defaultValue": "gridgame",
      "minLength": 3,
      "maxLength": 11,
      "metadata": {
        "description": "Short name used as the prefix for every resource. Lowercase letters and digits only."
      }
    },
    "sqlAdminLogin": {
      "type": "string",
      "defaultValue": "gridgameadmin",
      "minLength": 4,
      "metadata": {
        "description": "SQL Server administrator login name. Not a secret, but not guessable either."
      }
    },
    "sqlAdminPassword": {
      "type": "securestring",
      "minLength": 16,
      "metadata": {
        "description": "SQL Server administrator password. Supplied from the SQL_ADMIN_PASSWORD GitHub secret."
      }
    },
    "jwtSigningKey": {
      "type": "securestring",
      "minLength": 32,
      "metadata": {
        "description": "HMAC key used to sign JWTs. Supplied from the JWT_SIGNING_KEY GitHub secret."
      }
    },
    "accessTokenExpiryMinutes": {
      "type": "int",
      "defaultValue": 60,
      "metadata": {
        "description": "Access token lifetime, in minutes."
      }
    },
    "refreshTokenExpiryDays": {
      "type": "int",
      "defaultValue": 30,
      "metadata": {
        "description": "Refresh token lifetime, in days."
      }
    },
    "useSqlFreeLimit": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Claim the Azure SQL free offer (100,000 vCore-seconds and 32 GB per month, forever). Ten free databases are allowed per subscription; set this to false if that allowance is exhausted and you are willing to pay serverless rates for this one."
      }
    },
    "enableWebSockets": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Request WebSocket support on the web app. SignalR prefers WebSockets and degrades to Server-Sent Events / long polling without them, which still works for a turn-based game. Set to false if the F1 plan rejects the setting in your region."
      }
    },
    "clientIpAddress": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Optional public IPv4 address allowed to reach the SQL server directly, so you can point SSMS or dotnet-ef at it. Leave empty to allow only Azure-hosted services (i.e. the web app)."
      }
    }
  },
  "variables": {
    "suffix": "[take(uniqueString(resourceGroup().id), 8)]",
    "planName": "[format('{0}-plan-{1}', parameters('appName'), variables('suffix'))]",
    "siteName": "[format('{0}-{1}', parameters('appName'), variables('suffix'))]",
    "sqlServerName": "[format('{0}-sql-{1}', parameters('appName'), variables('suffix'))]",
    "sqlDatabaseName": "GridGame",
    "freeOfferMaxSizeBytes": 34359738368,
    "freeOfferProperties": "[if(parameters('useSqlFreeLimit'), createObject('useFreeLimit', true(), 'freeLimitExhaustionBehavior', 'AutoPause'), createObject())]"
  },
  "resources": [
    {
      "type": "Microsoft.Sql/servers",
      "apiVersion": "2023-08-01",
      "name": "[variables('sqlServerName')]",
      "location": "[parameters('location')]",
      "properties": {
        "administratorLogin": "[parameters('sqlAdminLogin')]",
        "administratorLoginPassword": "[parameters('sqlAdminPassword')]",
        "version": "12.0",
        "minimalTlsVersion": "1.2",
        "publicNetworkAccess": "Enabled"
      }
    },
    {
      "type": "Microsoft.Sql/servers/firewallRules",
      "apiVersion": "2023-08-01",
      "name": "[format('{0}/{1}', variables('sqlServerName'), 'AllowAllWindowsAzureIps')]",
      "properties": {
        "startIpAddress": "0.0.0.0",
        "endIpAddress": "0.0.0.0"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Sql/servers', variables('sqlServerName'))]"
      ]
    },
    {
      "condition": "[not(empty(parameters('clientIpAddress')))]",
      "type": "Microsoft.Sql/servers/firewallRules",
      "apiVersion": "2023-08-01",
      "name": "[format('{0}/{1}', variables('sqlServerName'), 'AllowDeveloperMachine')]",
      "properties": {
        "startIpAddress": "[parameters('clientIpAddress')]",
        "endIpAddress": "[parameters('clientIpAddress')]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Sql/servers', variables('sqlServerName'))]"
      ]
    },
    {
      "type": "Microsoft.Sql/servers/databases",
      "apiVersion": "2023-08-01",
      "name": "[format('{0}/{1}', variables('sqlServerName'), variables('sqlDatabaseName'))]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "GP_S_Gen5_2",
        "tier": "GeneralPurpose",
        "family": "Gen5",
        "capacity": 2
      },
      "properties": "[union(createObject('collation', 'SQL_Latin1_General_CP1_CI_AS', 'maxSizeBytes', variables('freeOfferMaxSizeBytes'), 'autoPauseDelay', 60, 'minCapacity', json('0.5'), 'zoneRedundant', false(), 'requestedBackupStorageRedundancy', 'Local'), variables('freeOfferProperties'))]",
      "dependsOn": [
        "[resourceId('Microsoft.Sql/servers', variables('sqlServerName'))]"
      ]
    },
    {
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2023-12-01",
      "name": "[variables('planName')]",
      "location": "[parameters('location')]",
      "kind": "linux",
      "sku": {
        "name": "F1",
        "tier": "Free"
      },
      "properties": {
        "reserved": true
      }
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2023-12-01",
      "name": "[variables('siteName')]",
      "location": "[parameters('location')]",
      "kind": "app,linux",
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', variables('planName'))]",
        "httpsOnly": true,
        "siteConfig": {
          "linuxFxVersion": "DOTNETCORE|10.0",
          "alwaysOn": false,
          "webSocketsEnabled": "[parameters('enableWebSockets')]",
          "http20Enabled": true,
          "minTlsVersion": "1.2",
          "ftpsState": "Disabled",
          "appSettings": [
            {
              "name": "ASPNETCORE_ENVIRONMENT",
              "value": "Production"
            },
            {
              "name": "ASPNETCORE_FORWARDEDHEADERS_ENABLED",
              "value": "true"
            },
            {
              "name": "ConnectionStrings__GridGame",
              "value": "[format('Server=tcp:{0},1433;Initial Catalog={1};Persist Security Info=False;User ID={2};Password={3};MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=90;ConnectRetryCount=12;ConnectRetryInterval=10;', reference(resourceId('Microsoft.Sql/servers', variables('sqlServerName')), '2023-08-01').fullyQualifiedDomainName, variables('sqlDatabaseName'), parameters('sqlAdminLogin'), parameters('sqlAdminPassword'))]"
            },
            {
              "name": "Jwt__Key",
              "value": "[parameters('jwtSigningKey')]"
            },
            {
              "name": "Jwt__AccessTokenExpiryMinutes",
              "value": "[string(parameters('accessTokenExpiryMinutes'))]"
            },
            {
              "name": "Jwt__RefreshTokenExpiryDays",
              "value": "[string(parameters('refreshTokenExpiryDays'))]"
            },
            {
              "name": "SCM_DO_BUILD_DURING_DEPLOYMENT",
              "value": "false"
            },
            {
              "name": "WEBSITES_CONTAINER_START_TIME_LIMIT",
              "value": "600"
            }
          ]
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Sql/servers/firewallRules', variables('sqlServerName'), 'AllowAllWindowsAzureIps')]",
        "[resourceId('Microsoft.Web/serverfarms', variables('planName'))]",
        "[resourceId('Microsoft.Sql/servers', variables('sqlServerName'))]"
      ]
    }
  ],
  "outputs": {
    "webAppName": {
      "type": "string",
      "metadata": {
        "description": "Name of the web app, consumed by the deploy job in the GitHub workflow."
      },
      "value": "[variables('siteName')]"
    },
    "webAppUrl": {
      "type": "string",
      "metadata": {
        "description": "Public URL of the deployed game."
      },
      "value": "[format('https://{0}', reference(resourceId('Microsoft.Web/sites', variables('siteName')), '2023-12-01').defaultHostName)]"
    },
    "sqlServerFqdn": {
      "type": "string",
      "metadata": {
        "description": "Fully qualified name of the SQL server, for pointing local tooling at it."
      },
      "value": "[reference(resourceId('Microsoft.Sql/servers', variables('sqlServerName')), '2023-08-01').fullyQualifiedDomainName]"
    },
    "sqlDatabaseName": {
      "type": "string",
      "metadata": {
        "description": "Name of the database within that server."
      },
      "value": "[variables('sqlDatabaseName')]"
    },
    "webAppPrincipalId": {
      "type": "string",
      "metadata": {
        "description": "Principal id of the web app managed identity, for granting it access to other resources later."
      },
      "value": "[reference(resourceId('Microsoft.Web/sites', variables('siteName')), '2023-12-01', 'full').identity.principalId]"
    }
  }
}